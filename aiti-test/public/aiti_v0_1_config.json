{
  "schema_version": "AITI_CONFIG_V0_1",
  "name": "AITI: AI Type Index",
  "description": "16 个 AI 助手 × 24 个英文人格标签 × 30 道四选一生活化测试题。用于测试页面开发的单文件配置。",
  "language": "zh-CN",
  "scoring_rules": {
    "question_type": "single_choice",
    "option_score_scale": "+3 核心倾向，+2 明显副倾向，+1 轻微倾向或隐藏 bug",
    "personality_score": "用户每题选择一个选项后，将该选项 scores 累加到用户人格向量。",
    "ai_match": "建议将用户人格向量与每个 AI 的 weights 向量计算相似度，再归一化为百分比。",
    "recommended_formula": {
      "similarity": "cosine_similarity(user_personality_vector, ai_weight_vector)",
      "percentage": "softmax(alpha * similarity), alpha 建议 6–10；或直接将正相似度归一化。"
    },
    "bug_labels": [
      "LIAR",
      "FLATTERER"
    ],
    "note": "LIAR/FLATTERER 是用户隐藏 bug，不建议作为某个真实 AI 的直接贬义标签。"
  },
  "personalities": [
